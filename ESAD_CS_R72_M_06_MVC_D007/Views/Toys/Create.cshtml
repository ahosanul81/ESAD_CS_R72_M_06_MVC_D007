@model ESAD_CS_R72_M_06_MVC_D007.Models.ViewModel.ToyVM
@{
    ViewBag.Title = "Create";
}

<div class="row border border-2 border-success p-4 rounded-3">
    <div class="col d-flex justify-content-center">
        <div id="msg"></div>
        @using (Ajax.BeginForm(
                "Create",
                new {},
                
                new AjaxOptions
                {
                    HttpMethod = "POST",
                    InsertionMode = InsertionMode.Replace,
                    UpdateTargetId = "msg",
                    OnComplete = "clearAll",
                   
                }, new {@class = "w-100"}
            )
        )
        {
            @Html.AntiForgeryToken();
            <h2 class="display-5">Add New Toy</h2>
            <div class="row mb-2">
                @Html.LabelFor(x => x.ToyName, htmlAttributes: new { @class = "col-form-label col-form-label-sm col-3" })
                <div class="col-6">
                    @Html.TextBoxFor(x => x.ToyName, new { @class = "form-control form-control-sm" })
                </div>
                <div class="col-3">
                    @Html.ValidationMessageFor(x => x.ToyName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row mb-2">
                @Html.LabelFor(x => x.cId, htmlAttributes: new { @class = "col-form-label col-form-label-sm col-3" })
                <div class="col-6">
                    @Html.DropDownListFor(x => x.cId, ViewBag.categories as SelectList, "--Select--", new { @class = "form-select form-select-sm" })
                </div>
                <div class="col-3">
                    @Html.ValidationMessageFor(x => x.cId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row mb-2">
                @Html.LabelFor(x => x.Price, htmlAttributes: new { @class = "col-form-label col-form-label-sm col-3" })
                <div class="col-6">
                    @Html.TextBoxFor(x => x.Price, new { @class = "form-control form-control-sm" })
                </div>
                <div class="col-3">
                    @Html.ValidationMessageFor(x => x.Price, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row mb-2">
                @Html.LabelFor(x => x.StoreDate, htmlAttributes: new { @class = "col-form-label col-form-label-sm col-3" })
                <div class="col-6">
                    @Html.TextBoxFor(x => x.StoreDate, new { @class = "form-control form-control-sm", type = "date" })
                </div>
                <div class="col-3">
                    @Html.ValidationMessageFor(x => x.StoreDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row mb-2">
                @Html.LabelFor(x => x.Picture, htmlAttributes: new { @class = "col-form-label col-form-label-sm col-3" })
                <div class="col-6">
                    @Html.TextBoxFor(x => x.Picture, new { @class = "form-control form-control-sm", type = "file" })
                </div>
                <div class="col-3">
                    @Html.ValidationMessageFor(x => x.Picture, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row mb-2">

                <div class="col-9 ">
                    <button type="reset" class="btn btn-warning btn-sm"><i class="fa fa-refresh"></i> Reset</button>
                    <button type="submit" class="btn btn-success btn-sm" id="btnCreate"><i class="fa fa-save"></i> Save to Database </button>
                </div>
            </div>

        }
    </div>
</div>
<div class="d-flex justify-content-end">
    <a href="@Url.Action("Index","Toys")" class="btn btn-link btn-sm" style="text-decoration:none;"><i class="fa fa-arrow-circle-left"></i> Back To List</a>
</div>
@section scripts{
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

    <script>
        $("#form0").attr("encType", "multipart/form-data")
        function clearAll() {
            $("#form0").trigger("reset")
        }
    </script>
}
